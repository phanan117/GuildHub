# Copy file này thành ".env" rồi điền thông tin của bạn

# ================= BOT CHÍNH (guildhub-bot) =================
DISCORD_BOT_TOKEN=YOUR_MAIN_DISCORD_BOT_TOKEN
# Để trống nếu muốn chạy Global nhiều server; điền Server ID nếu chỉ test 1 server
DISCORD_DEV_GUILD_ID=
# Kết nối tới PostgreSQL trên máy Windows của bạn
BOT_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=guildhub;Username=postgres;Password=MAT_KHAU_POSTGRES_CUA_BAN

# ================= BOT DEMO (guildhub-bot-demo) =================
# Dùng khi cần chạy thêm 1 bot khác song song để demo ở server khác (DB riêng: guildhub_demo):
#   docker compose --profile demo up -d --build bot-demo
DISCORD_DEMO_BOT_TOKEN=YOUR_DEMO_DISCORD_BOT_TOKEN
DISCORD_DEMO_DEV_GUILD_ID=
BOT_DEMO_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=guildhub_demo;Username=postgres;Password=MAT_KHAU_POSTGRES_CUA_BAN

# ================= WEB QUẢN TRỊ (guildhub-web) =================
# Lấy Client ID & Client Secret tại Discord Developer Portal -> OAuth2
# Thêm Redirect URL vào Discord Developer Portal -> OAuth2 -> Redirects:
#   http://localhost:5080/auth/discord-callback  (hoặc https://domain-cua-ban/auth/discord-callback)
WEB_PORT=5080
WEB_PUBLIC_BASE_URL=http://localhost:5080
DISCORD_WEB_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_WEB_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
