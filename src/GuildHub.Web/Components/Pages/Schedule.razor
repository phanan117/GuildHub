    private async Task TriggerFormNowAsync(CalendarEventItem item)
    {
        if (!item.ScheduledEventId.HasValue)
        {
            return;
        }

        var scheduleId = item.ScheduledEventId.Value;
        var result = await ScheduleService.TriggerFormNowAsync(Session.CurrentGuildId, scheduleId);
        if (!result.Success)
        {
            ShowToast(result.Message, "error");
            return;
        }

        ShowToast(result.Message, "info");
        _triggeringScheduleId = scheduleId;
        await LoadCalendarAsync();

        // Chờ tối đa 16 giây để Bot worker nhặt và đăng form rồi cập nhật tức thì trên UI
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;

        try
        {
            for (var attempt = 0; attempt < 8 && !token.IsCancellationRequested; attempt++)
            {
                await Task.Delay(2000, token);
                var updated = await ScheduleService.GetScheduleByIdAsync(Session.CurrentGuildId, scheduleId, token);
                if (updated is null)
                {
                    break;
                }

                if (updated.CreatedWarEventId.HasValue)
                {
                    ShowToast($"Bot đã đăng form thành công (Event #{updated.CreatedWarEventId.Value})!", "success");
                    await LoadCalendarAsync();
                    if (_selectedItem?.ScheduledEventId == scheduleId)
                    {
                        await LoadSignupDetailAsync(updated.CreatedWarEventId.Value);
                    }
                    break;
                }

                if (!string.IsNullOrWhiteSpace(updated.LastFormError))
                {
                    ShowToast(updated.LastFormError, "error");
                    await LoadCalendarAsync();
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Người dùng rời trang hoặc kích hoạt lại
        }
        finally
        {
            if (_triggeringScheduleId == scheduleId)
            {
                _triggeringScheduleId = null;
                StateHasChanged();
            }
        }
    }

