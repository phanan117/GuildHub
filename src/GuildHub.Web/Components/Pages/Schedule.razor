    protected override async Task OnInitializedAsync()
    {
        Session.StateChanged += HandleSessionChanged;
        BuildCalendarGrid();
        await LoadCalendarAsync();
        _ = EnsureDiscordMetadataLoadedAsync();
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            _selectedItem = null;
            _signupDetail = null;
            _showFormModal = false;
            await LoadCalendarAsync();
            await EnsureDiscordMetadataLoadedAsync();
            StateHasChanged();
        });
    }

    private void BuildCalendarGrid()
    {
        var firstOfMonth = new DateOnly(_currentMonth.Year, _currentMonth.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);
        var lastOfMonth = new DateOnly(_currentMonth.Year, _currentMonth.Month, daysInMonth);

        // Thứ 2 = 0 ... Chủ Nhật = 6
        var startOffset = ((int)firstOfMonth.DayOfWeek + 6) % 7;
        var gridStart = firstOfMonth.AddDays(-startOffset);

        var endOffset = 6 - (((int)lastOfMonth.DayOfWeek + 6) % 7);
        var gridEnd = lastOfMonth.AddDays(endOffset);

        var days = new List<DateOnly>();
        for (var d = gridStart; d <= gridEnd; d = d.AddDays(1))
        {
            days.Add(d);
        }

        _calendarDays = days;
    }

    private async Task LoadCalendarAsync()
    {
        if (Session.CurrentGuildId == 0 || _calendarDays.Count == 0)
        {
            return;
        }

        _loadingCalendar = true;
        StateHasChanged();

        try
        {
            var rangeStartUtc = new DateTimeOffset(_calendarDays[0].ToDateTime(TimeOnly.MinValue), VietnamOffset).ToUniversalTime();
            var rangeEndUtc = new DateTimeOffset(_calendarDays[^1].AddDays(1).ToDateTime(TimeOnly.MinValue), VietnamOffset).ToUniversalTime();

            var monthStartUtc = new DateTimeOffset(_currentMonth.ToDateTime(TimeOnly.MinValue), VietnamOffset).ToUniversalTime();
            var monthEndUtc = new DateTimeOffset(_currentMonth.AddMonths(1).ToDateTime(TimeOnly.MinValue), VietnamOffset).ToUniversalTime();

            EventType? filterType = int.TryParse(_filterTypeValue, out var typeInt) ? (EventType)typeInt : null;

            _monthData = await ScheduleService.GetCalendarRangeAsync(
                Session.CurrentGuildId,
                rangeStartUtc,
                rangeEndUtc,
                monthStartUtc,
                monthEndUtc,
                filterType);

            _itemsByDay = _monthData.Items
                .GroupBy(i => DateOnly.FromDateTime(i.ScheduledTimeUtc.ToOffset(VietnamOffset).DateTime))
                .ToDictionary(g => g.Key, g => g.ToList());

            // Đồng bộ lại _selectedItem nếu Drawer đang mở
            if (_selectedItem is not null)
            {
                _selectedItem = _monthData.Items.FirstOrDefault(i =>
                    (_selectedItem.ScheduledEventId.HasValue && i.ScheduledEventId == _selectedItem.ScheduledEventId)
                    || (!_selectedItem.ScheduledEventId.HasValue && _selectedItem.WarEventId.HasValue && i.WarEventId == _selectedItem.WarEventId));
            }
        }
        finally
        {
            _loadingCalendar = false;
            StateHasChanged();
        }
    }

    private async Task EnsureDiscordMetadataLoadedAsync()
    {
        if (Session.CurrentGuildId == 0 || _loadedMetaGuildId == Session.CurrentGuildId)
        {
            return;
        }

        _loadingDiscordMeta = true;
        StateHasChanged();

        try
        {
            var guildId = Session.CurrentGuildId;
            var channelsTask = SyncService.GetGuildTextChannelsAsync(guildId);
            var rolesTask = SyncService.GetGuildRolesAsync(guildId, includeEveryone: true);
            await Task.WhenAll(channelsTask, rolesTask);

            _channels = channelsTask.Result;
            _roles = rolesTask.Result;
            _loadedMetaGuildId = guildId;
        }
        finally
        {
            _loadingDiscordMeta = false;
            StateHasChanged();
        }
    }

