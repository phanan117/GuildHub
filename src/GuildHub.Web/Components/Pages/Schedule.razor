    private List<WarEventSignupRow> GetFilteredSignups()
    {
        if (_signupDetail is null)
        {
            return [];
        }

        IEnumerable<WarEventSignupRow> q = _signupDetail.Signups;

        if (_signupStatusFilter == "active")
        {
            q = q.Where(s => s.Status is SignupStatus.Confirmed or SignupStatus.Late or SignupStatus.Bench);
        }
        else if (int.TryParse(_signupStatusFilter, out var stInt))
        {
            var status = (SignupStatus)stInt;
            q = q.Where(s => s.Status == status);
        }

        if (!string.IsNullOrWhiteSpace(_signupSearch))
        {
            var term = _signupSearch.Trim();
            q = q.Where(s =>
                s.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(s.IngameNickname) && s.IngameNickname.Contains(term, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(s.ClassDisplayName) && s.ClassDisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        return q.ToList();
    }

    private bool TryComputeClosePreview(out DateTimeOffset previewVn)
    {
        previewVn = default;
        if (!TryParseVnDateTime(_formEventDateStr, _formEventHour, _formEventMinute, out var scheduledLocal))
        {
            return false;
        }

        if (int.TryParse(_formClosePreset, out var mins))
        {
            previewVn = scheduledLocal.AddMinutes(-mins);
            return true;
        }

        return false;
    }

    private bool TryComputeAutoCreatePreview(out DateTimeOffset previewVn)
    {
        previewVn = default;
        if (!TryParseVnDateTime(_formEventDateStr, _formEventHour, _formEventMinute, out var scheduledLocal))
        {
            return false;
        }

        if (int.TryParse(_formAutoPreset, out var hours))
        {
            previewVn = scheduledLocal.AddHours(-hours);
            return true;
        }

        return false;
    }

    private static bool TryParseVnDateTime(string dateStr, string? hourStr, string? minuteStr, out DateTimeOffset result)
    {
        result = default;
        if (!DateOnly.TryParseExact(dateStr, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            return false;
        }

        if (!int.TryParse(hourStr, out var hour) || hour is < 0 or > 23)
        {
            return false;
        }

        if (!int.TryParse(minuteStr, out var minute) || minute is < 0 or > 59)
        {
            return false;
        }

        result = new DateTimeOffset(date.ToDateTime(new TimeOnly(hour, minute)), VietnamOffset);
        return true;
    }

