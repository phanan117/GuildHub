        _showFormModal = false;
        _formError = null;
    }

    private async Task SaveScheduleAsync()
    {
        _formError = null;

        if (!TryParseVnDateTime(_formEventDateStr, _formEventHour, _formEventMinute, out var scheduledLocal))
        {
            _formError = "Vui lòng chọn ngày và giờ bắt đầu hợp lệ.";
            return;
        }

        DateTimeOffset? closeTimeUtc = null;
        if (_formClosePreset == "custom")
        {
            if (!TryParseVnDateTime(_formCloseDateStr, _formCloseHour, _formCloseMinute, out var closeLocal))
            {
                _formError = "Vui lòng chọn ngày và giờ đóng form hợp lệ.";
                return;
            }
            closeTimeUtc = closeLocal.ToUniversalTime();
        }
        else if (int.TryParse(_formClosePreset, out var closeMins))
        {
            closeTimeUtc = scheduledLocal.AddMinutes(-closeMins).ToUniversalTime();
        }

        DateTimeOffset? autoCreateAtUtc = null;
        if (_formAutoCreate && !_editingHasCreatedForm)
        {
            if (_formAutoPreset == "custom")
            {
                if (!TryParseVnDateTime(_formAutoDateStr, _formAutoHour, _formAutoMinute, out var autoLocal))
                {
                    _formError = "Vui lòng chọn thời điểm tự động mở form hợp lệ.";
                    return;
                }
                autoCreateAtUtc = autoLocal.ToUniversalTime();
            }
            else if (int.TryParse(_formAutoPreset, out var autoHours))
            {
                autoCreateAtUtc = scheduledLocal.AddHours(-autoHours).ToUniversalTime();
            }
        }

        ulong? channelId = ulong.TryParse(_formChannelIdStr, out var cid) ? cid : null;
        var channelName = channelId.HasValue ? _channels.FirstOrDefault(c => c.ChannelId == channelId.Value)?.Name : null;

        ulong? roleId = ulong.TryParse(_formMentionRoleIdStr, out var rid) ? rid : null;
        var roleName = roleId.HasValue ? _roles.FirstOrDefault(r => r.RoleId == roleId.Value)?.Name : null;

        var eventType = int.TryParse(_formEventTypeStr, out var et) ? (EventType)et : EventType.GuildWar;

        var request = new ScheduleUpsertRequest(
            Title: _formTitle,
            Description: _formDescription,
            EventType: eventType,
            ScheduledTimeUtc: scheduledLocal.ToUniversalTime(),
            CloseTimeUtc: closeTimeUtc,
            AutoCreateForm: _formAutoCreate,
            AutoCreateAtUtc: autoCreateAtUtc,
            TargetChannelId: channelId,
            TargetChannelName: channelName,
            MentionRoleId: roleId,
            MentionRoleName: roleName);

        _savingForm = true;
        StateHasChanged();

        try
        {
            var result = _editingScheduleId.HasValue
                ? await ScheduleService.UpdateScheduleAsync(Session.CurrentGuildId, _editingScheduleId.Value, request)
                : await ScheduleService.CreateScheduleAsync(Session.CurrentGuildId, Session.User?.UserId ?? 0, request);

            if (!result.Success)
            {
                _formError = result.Message;
                return;
            }

            _showFormModal = false;
            ShowToast(result.Message, "success");

            // Nếu sự kiện mới nằm ở tháng khác -> chuyển lịch tới tháng đó để Admin thấy ngay
            var eventMonth = new DateOnly(scheduledLocal.Year, scheduledLocal.Month, 1);
            if (eventMonth != _currentMonth)
            {
                _currentMonth = eventMonth;
                BuildCalendarGrid();
            }

            await LoadCalendarAsync();
        }
        finally
        {
            _savingForm = false;
            StateHasChanged();
        }
    }

