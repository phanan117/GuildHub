    private async Task OpenEditModalAsync(CalendarEventItem item)
    {
        if (!item.ScheduledEventId.HasValue)
        {
            return;
        }

        await EnsureDiscordMetadataLoadedAsync();

        var localStart = item.ScheduledTimeUtc.ToOffset(VietnamOffset);
        _editingScheduleId = item.ScheduledEventId.Value;
        _editingHasCreatedForm = item.WarEventId.HasValue;
        _formError = null;

        _formTitle = item.Title;
        _formDescription = item.Description ?? string.Empty;
        _formEventTypeStr = ((int)item.EventType).ToString();
        _formEventDateStr = localStart.ToString("yyyy-MM-dd");
        _formEventHour = localStart.ToString("HH");
        _formEventMinute = localStart.ToString("mm");

        if (!item.CloseTimeUtc.HasValue)
        {
            _formClosePreset = "none";
            _formCloseDateStr = localStart.ToString("yyyy-MM-dd");
            _formCloseHour = localStart.AddMinutes(-30).ToString("HH");
            _formCloseMinute = localStart.AddMinutes(-30).ToString("mm");
        }
        else
        {
            var localClose = item.CloseTimeUtc.Value.ToOffset(VietnamOffset);
            _formCloseDateStr = localClose.ToString("yyyy-MM-dd");
            _formCloseHour = localClose.ToString("HH");
            _formCloseMinute = localClose.ToString("mm");

            var diffMins = (int)Math.Round((item.ScheduledTimeUtc - item.CloseTimeUtc.Value).TotalMinutes);
            _formClosePreset = diffMins is 15 or 30 or 60 or 120 ? diffMins.ToString() : "custom";
        }

        _formChannelIdStr = item.TargetChannelId?.ToString() ?? string.Empty;
        _formMentionRoleIdStr = item.MentionRoleId?.ToString() ?? string.Empty;
        _formAutoCreate = item.AutoCreateForm;

        if (item.AutoCreateForm && item.AutoCreateAtUtc.HasValue)
        {
            var localAuto = item.AutoCreateAtUtc.Value.ToOffset(VietnamOffset);
            _formAutoDateStr = localAuto.ToString("yyyy-MM-dd");
            _formAutoHour = localAuto.ToString("HH");
            _formAutoMinute = localAuto.ToString("mm");

            var diffHours = (int)Math.Round((item.ScheduledTimeUtc - item.AutoCreateAtUtc.Value).TotalHours);
            var exactDiffMins = Math.Abs((item.ScheduledTimeUtc - item.AutoCreateAtUtc.Value).TotalMinutes - diffHours * 60);
            _formAutoPreset = exactDiffMins < 1 && diffHours is 6 or 12 or 24 or 48 or 72 ? diffHours.ToString() : "custom";
        }
        else
        {
            var defaultAuto = localStart.AddDays(-1);
            _formAutoPreset = "24";
            _formAutoDateStr = defaultAuto.ToString("yyyy-MM-dd");
            _formAutoHour = defaultAuto.ToString("HH");
            _formAutoMinute = defaultAuto.ToString("mm");
        }

        _showFormModal = true;
    }

