@page "/"
@attribute [Authorize]
@implements IDisposable
@inject GuildSessionState Session
@inject DashboardService DashboardService

<PageTitle>Tổng quan — GuildHub</PageTitle>

<div class="space-y-6">
    @if (_metrics is null)
    {
        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center text-slate-500 shadow-card">
            <span class="inline-block w-6 h-6 border-2 border-brand-600 border-t-transparent rounded-full animate-spin align-middle mr-2"></span>
            Đang tải dữ liệu tổng quan bang hội...
        </div>
    }
    else
    {
        <!-- 4 KPI Cards (khớp Ảnh 1) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <button type="button" @onclick="() => ApplyQuickMemberFilter(MemberLinkFilter.ActiveAll)"
                    class="text-left bg-white hover:border-brand-300 rounded-2xl border border-slate-200/90 shadow-card p-5 transition cursor-pointer">
                <div class="text-xs font-semibold text-slate-500">Tổng thành viên</div>
                <div class="text-3xl font-extrabold text-slate-900 mt-2 tracking-tight">@_metrics.TotalActiveMembers</div>
                <div class="text-xs text-slate-500 mt-1.5">@_metrics.TotalActiveMembers đang hoạt động</div>
            </button>

            <button type="button" @onclick="() => ApplyQuickMemberFilter(MemberLinkFilter.Linked)"
                    class="text-left bg-white hover:border-emerald-300 rounded-2xl border border-slate-200/90 shadow-card p-5 transition cursor-pointer">
                <div class="text-xs font-semibold text-slate-500">Đã liên kết</div>
                <div class="text-3xl font-extrabold text-slate-900 mt-2 tracking-tight">@_metrics.LinkedMembers</div>
                <div class="text-xs text-slate-500 mt-1.5">Đã chọn môn phái</div>
            </button>

            <button type="button" @onclick="() => ApplyQuickMemberFilter(MemberLinkFilter.Unlinked)"
                    class="text-left bg-white hover:border-amber-300 rounded-2xl border border-slate-200/90 shadow-card p-5 transition cursor-pointer">
                <div class="text-xs font-semibold text-slate-500">Chưa liên kết</div>
                <div class="text-3xl font-extrabold text-slate-900 mt-2 tracking-tight">@_metrics.UnlinkedMembers</div>
                <div class="text-xs text-slate-500 mt-1.5">Cần hoàn tất liên kết</div>
            </button>

            <button type="button" @onclick="() => ApplyQuickMemberFilter(MemberLinkFilter.Removed)"
                    class="text-left bg-white hover:border-rose-300 rounded-2xl border border-slate-200/90 shadow-card p-5 transition cursor-pointer">
                <div class="text-xs font-semibold text-slate-500">Đã remove</div>
                <div class="text-3xl font-extrabold text-slate-900 mt-2 tracking-tight">@_metrics.RemovedMembers</div>
                <div class="text-xs text-slate-500 mt-1.5">Hồ sơ cũ: khôi phục hoặc xóa ngay</div>
            </button>
        </div>

        <!-- Middle Grid: Thông tin bang hội (3 Donuts) + Thống kê thành viên (3 Ring Gauges) -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-5">
            <!-- Left 8 cols: Thông tin bang hội -->
            <div class="xl:col-span-8 bg-white rounded-2xl border border-slate-200/90 shadow-card p-6">
                <div class="flex items-start justify-between gap-4 mb-5">
                    <div>
                        <div class="text-xs font-medium text-slate-500">Dữ liệu hiện tại</div>
                        <h2 class="text-lg font-extrabold text-slate-900 tracking-tight mt-0.5">Thông tin bang hội</h2>
                    </div>
                    <span class="text-xs font-medium text-slate-400">Cập nhật theo dữ liệu thực</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Donut 1: Trạng thái thành viên -->
                    <div class="bg-sky-50/60 border border-slate-200/70 rounded-2xl p-4 flex flex-col items-center">
                        <DonutChart Segments="@StatusSegments"
                                    CenterValue="@_metrics.TotalActiveMembers.ToString()"
                                    CenterLabel="thành viên"
                                    Size="132" />
                        <div class="text-xs font-bold text-slate-800 mt-3 mb-3 text-center">Trạng thái thành viên</div>
                        <div class="w-full space-y-1.5 text-xs">
                            <div class="flex items-center justify-between px-1">
                                <span class="inline-flex items-center gap-2 text-slate-600">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background:#6d597a"></span>Đã link
                                </span>
                                <strong class="text-slate-800">@_metrics.LinkedMembers</strong>
                            </div>
                            <div class="flex items-center justify-between px-1">
                                <span class="inline-flex items-center gap-2 text-slate-600">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background:#d4a353"></span>Chưa link
                                </span>
                                <strong class="text-slate-800">@_metrics.UnlinkedMembers</strong>
                            </div>
                            <div class="flex items-center justify-between px-1">
                                <span class="inline-flex items-center gap-2 text-slate-600">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background:#c47a8e"></span>Đã remove
                                </span>
                                <strong class="text-slate-800">@_metrics.RemovedMembers</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Donut 2: Phân bổ môn phái -->
                    <div class="bg-sky-50/60 border border-slate-200/70 rounded-2xl p-4 flex flex-col items-center">
                        <DonutChart Segments="@ClassSegments"
                                    CenterValue="@_metrics.LinkedMembers.ToString()"
                                    CenterLabel="thành viên"
                                    Size="132" />
                        <div class="text-xs font-bold text-slate-800 mt-3 mb-3 text-center">Phân bổ môn phái</div>
                        <div class="w-full space-y-1 text-xs">
                            @foreach (var item in _metrics.ClassDistribution)
                            {
                                <div class="flex items-center justify-between px-1">
                                    <span class="inline-flex items-center gap-1.5 text-slate-700">
                                        <img src="/icons/@item.Info.IconFileName" alt="@item.Info.DisplayName" class="w-4 h-4 object-contain" />
                                        <span class="w-2 h-2 rounded-full" style="background:@item.Info.HexColor"></span>
                                        <span>@item.Info.DisplayName</span>
                                    </span>
                                    <strong class="text-slate-800">@item.Count</strong>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Donut 3: Điểm danh gần nhất -->
                    <div class="bg-sky-50/60 border border-slate-200/70 rounded-2xl p-4 flex flex-col items-center">
                        <DonutChart Segments="@LatestEventSegments"
                                    CenterValue="@((_metrics.LatestEvent?.ActiveCount ?? 0).ToString())"
                                    CenterLabel="thành viên"
                                    Size="132" />
                        <div class="text-xs font-bold text-slate-800 mt-3 mb-3 text-center line-clamp-2">
                            @(_metrics.LatestEvent is not null ? $"Điểm danh gần nhất: {_metrics.LatestEvent.Title}" : "Chưa có phiên điểm danh")
                        </div>
                        <div class="w-full space-y-1.5 text-xs">
                            <div class="flex items-center justify-between px-1">
                                <span class="inline-flex items-center gap-2 text-slate-600">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background:#5a9a76"></span>Tham gia
                                </span>
                                <strong class="text-slate-800">@(_metrics.LatestEvent?.ActiveCount ?? 0)</strong>
                            </div>
                            <div class="flex items-center justify-between px-1">
                                <span class="inline-flex items-center gap-2 text-slate-600">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background:#c47a8e"></span>Vắng / Bận
                                </span>
                                <strong class="text-slate-800">@(_metrics.LatestEvent?.BusyOrAbsentCount ?? 0)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right 4 cols: Thống kê thành viên -->
            <div class="xl:col-span-4 bg-white rounded-2xl border border-slate-200/90 shadow-card p-6 flex flex-col">
                <div class="mb-5">
                    <div class="text-xs font-medium text-slate-500">Chỉ số hiện tại</div>
                    <h2 class="text-lg font-extrabold text-slate-900 tracking-tight mt-0.5">Thống kê thành viên</h2>
                </div>

                <div class="space-y-3.5 flex-1 flex flex-col justify-center">
                    <RingGauge Percent="@_metrics.LinkRatePercent"
                               Title="Tỷ lệ liên kết"
                               Subtitle="@($"Mức hiện tại {_metrics.LinkRatePercent}%")"
                               AccentColor="#6d597a" />

                    <RingGauge Percent="@_metrics.RolePresencePercent"
                               Title="Hiện diện trong role"
                               Subtitle="@($"Mức hiện tại {_metrics.RolePresencePercent}%")"
                               AccentColor="#5a9a76" />

                    <RingGauge Percent="@(_metrics.LatestEvent?.ParticipationPercent ?? 0)"
                               Title="Tỷ lệ tham gia gần nhất"
                               Subtitle="@($"Mức hiện tại {_metrics.LatestEvent?.ParticipationPercent ?? 0}%")"
                               AccentColor="#d4a353" />
                </div>
            </div>
        </div>

        <!-- Latest Event Banner -->
        @if (_metrics.LatestEvent is not null)
        {
            <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card px-6 py-4 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <div class="text-xs font-medium text-slate-500">Điểm danh gần nhất</div>
                    <div class="text-base font-extrabold text-slate-900 mt-0.5">@_metrics.LatestEvent.Title</div>
                    <div class="text-xs text-slate-500 mt-0.5">
                        @_metrics.LatestEvent.ActiveCount đăng ký tham gia · @_metrics.LatestEvent.TotalResponses phản hồi
                    </div>
                </div>

                <a href="/analytics"
                   class="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-sm font-semibold shadow-sm transition">
                    Xem phân tích hoạt động
                </a>
            </div>
        }

        <!-- Embedded Member Directory (giống Ảnh 1 -> kéo xuống Ảnh 2) -->
        <MemberDirectoryPanel ExternalStatusFilter="@_quickMemberFilter"
                              OnMembersChanged="RefreshDashboardOnlyAsync" />
    }
</div>

@code {
    private DashboardMetrics? _metrics;
    private MemberLinkFilter? _quickMemberFilter;

    private IReadOnlyList<DonutChart.DonutSegment> StatusSegments => _metrics is null
        ? []
        : [
            new("Đã link", _metrics.LinkedMembers, "#6d597a"),
            new("Chưa link", _metrics.UnlinkedMembers, "#d4a353"),
            new("Đã remove", _metrics.RemovedMembers, "#c47a8e")
        ];

    private IReadOnlyList<DonutChart.DonutSegment> ClassSegments => _metrics is null
        ? []
        : _metrics.ClassDistribution
            .Select(x => new DonutChart.DonutSegment(x.Info.DisplayName, x.Count, x.Info.HexColor))
            .ToList();

    private IReadOnlyList<DonutChart.DonutSegment> LatestEventSegments => _metrics?.LatestEvent is null
        ? []
        : [
            new("Tham gia", _metrics.LatestEvent.ActiveCount, "#5a9a76"),
            new("Vắng / Bận", _metrics.LatestEvent.BusyOrAbsentCount, "#c47a8e")
        ];

    protected override async Task OnInitializedAsync()
    {
        Session.StateChanged += HandleSessionChanged;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        if (Session.CurrentGuildId == 0)
        {
            return;
        }

        _metrics = await DashboardService.GetDashboardAsync(Session.CurrentGuildId);
    }

    private async Task RefreshDashboardOnlyAsync()
    {
        await LoadDashboardAsync();
        StateHasChanged();
    }

    private void ApplyQuickMemberFilter(MemberLinkFilter filter)
    {
        _quickMemberFilter = filter;
    }

    private async void HandleSessionChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDashboardAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Session.StateChanged -= HandleSessionChanged;
    }
}
