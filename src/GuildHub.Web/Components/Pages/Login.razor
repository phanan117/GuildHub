@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout

<PageTitle>Đăng nhập — GuildHub</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-[#eef5fb] via-[#f5f3ff] to-[#e0f2fe] flex items-center justify-center p-5">
    <div class="w-full max-w-md bg-white/95 backdrop-blur-md rounded-3xl border border-slate-200/80 shadow-xl p-8 sm:p-10">
        <!-- Logo & Title -->
        <div class="flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-600 to-indigo-900 text-white font-extrabold text-2xl flex items-center justify-center shadow-lg shadow-brand-600/20 mb-4">
                GH
            </div>
            <span class="text-xs font-bold uppercase tracking-widest text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-2">
                Không gian quản trị bang hội
            </span>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">GuildHub Admin Portal</h1>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                Đăng nhập bằng tài khoản Discord để quản lý thành viên, lịch bang chiến, chuyên cần và đội hình 60vs60.
            </p>
        </div>

        <!-- 8 Class Icons Showcase -->
        <div class="flex items-center justify-center gap-2.5 my-6 py-3 px-4 rounded-2xl bg-slate-50 border border-slate-100">
            @foreach (var cls in ClassMetadata.All)
            {
                <img src="/icons/@cls.FileName"
                     alt="@cls.DisplayName"
                     title="@cls.DisplayName"
                     class="w-6 h-6 object-contain hover:scale-125 transition-transform" />
            }
        </div>

        <!-- Error Banner -->
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="mb-5 bg-rose-50 border border-rose-200 text-rose-800 rounded-2xl px-4 py-3 text-xs leading-relaxed">
                <div class="font-bold mb-0.5">⚠️ Không thể đăng nhập</div>
                <div>@ErrorMessage</div>
            </div>
        }

        <!-- Discord Login Button -->
        <a href="/auth/discord-login"
           class="w-full inline-flex items-center justify-center gap-3 bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold text-sm py-3.5 px-5 rounded-2xl shadow-md shadow-[#5865F2]/25 transition">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
            </svg>
            <span>Đăng nhập bằng Discord</span>
        </a>

        <div class="mt-3 text-center">
            <a href="/auth/discord-login?switch=true"
               class="text-xs font-medium text-slate-500 hover:text-brand-600 underline underline-offset-2 transition">
                Đổi sang tài khoản Discord khác
            </a>
        </div>

        <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-400 leading-relaxed">
            Hệ thống sẽ tự động kiểm tra quyền <strong class="text-slate-600">Administrator / Manage Server</strong> trên server Discord có cài đặt Bot GuildHub.
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "not_admin" => "Tài khoản Discord của bạn không có quyền Administrator hoặc Manage Server trên bất kỳ server nào đã cài Bot GuildHub.",
        "not_configured" => "Chưa cấu hình DiscordWeb:ClientId và DiscordWeb:ClientSecret trong appsettings.json hoặc biến môi trường Docker (.env).",
        "cancelled" => "Bạn đã hủy đăng nhập Discord.",
        "invalid_state" => "Phiên xác thực OAuth2 đã hết hạn hoặc không hợp lệ. Vui lòng thử lại.",
        "token_failed" => "Không thể xác thực mã đăng nhập với Discord (kiểm tra lại Client Secret & Redirect URL trong Discord Developer Portal).",
        "profile_failed" or "guilds_failed" => "Không thể đọc thông tin tài khoản hoặc danh sách server từ Discord. Vui lòng thử lại.",
        _ => null
    };
}
