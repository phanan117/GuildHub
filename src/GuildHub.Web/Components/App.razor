<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>GuildHub — Quản lý Bang hội</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', '"Segoe UI"', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        canvas: '#eef5fb',
                        surface: '#ffffff',
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81'
                        },
                        slatebtn: {
                            DEFAULT: '#4a5c6d',
                            hover: '#3b4b5a'
                        }
                    },
                    boxShadow: {
                        card: '0 1px 3px rgba(15, 23, 42, 0.05), 0 6px 18px -6px rgba(15, 23, 42, 0.06)',
                        soft: '0 2px 10px -2px rgba(15, 23, 42, 0.06)'
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>

<body class="bg-canvas text-slate-800 antialiased selection:bg-brand-100 selection:text-brand-900">
    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        Đã có lỗi kết nối tạm thời.
        <a href="" class="underline font-semibold ml-1">Tải lại trang</a>
        <span class="dismiss" onclick="document.getElementById('blazor-error-ui').style.display='none'">✕</span>
    </div>

    <script src="_framework/blazor.web.js"></script>
</body>

</html>
